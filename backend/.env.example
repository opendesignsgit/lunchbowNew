# ─── App Business Logic Settings ───────────────────────────────────────────────
# These values are returned by GET /api/app-config and consumed by the mobile app.
# Changing them here (and restarting the server) updates the entire app instantly,
# without a new app release.  The dashboard will expose these as editable fields
# in a future milestone.

# Price charged per working day per child (INR)
PRICE_PER_DAY_PER_CHILD=225

# Plan durations in working days
PLAN_DAYS_1_MONTH=22
PLAN_DAYS_3_MONTHS=66
PLAN_DAYS_6_MONTHS=132

# Single-child discount percentages per plan tier
DISCOUNT_SINGLE_1M=0
DISCOUNT_SINGLE_3M=5
DISCOUNT_SINGLE_6M=10

# Multi-child (>= MULTI_CHILD_THRESHOLD) discount percentages per plan tier
DISCOUNT_MULTI_1M=5
DISCOUNT_MULTI_3M=15
DISCOUNT_MULTI_6M=20

# Minimum number of children to qualify for multi-child pricing
MULTI_CHILD_THRESHOLD=2

# Price per child for a single holiday meal booking (INR)
HOLIDAY_MEAL_PRICE_PER_CHILD=225

# Extra limits returned by /api/app-config and enforced by the payment API
MAX_CHILDREN=3
WALLET_MAX_REDEEM_PERCENT=80

# Plan prices sent by clients are recomputed on the server and rejected if they differ.
# Set to false only as an emergency switch.
# ENFORCE_SERVER_PRICING=true

# Trial @ 99 (enquiry only) — shown in the app when true
# ENABLE_TRIAL=false
# TRIAL_PRICE=99
# SUPPORT_PHONE=+91 91769 17602
# SUPPORT_EMAIL=contactus@lunchbowl.co.in
# WHATSAPP_NUMBER=919345407191

# ─── CCAvenue (server-side only — never put the working key in a client) ──────
# CCAV_MERCHANT_ID=...
# CCAV_ACCESS_CODE=...
# CCAV_WORKING_KEY=...
# Public URL of this API, used for CCAvenue redirect URLs (e.g. https://dev-api.lunchbowl.co.in on dev)
# API_PUBLIC_URL=https://api.lunchbowl.co.in
# Dev/test only: charge ₹1 for payments created by /api/ccavenue/initiate
# CCAV_TEST_AMOUNT_RE1=true

# Test-only payment endpoints (/api/ccavenue/local-success, /local-success/local-add-childPayment,
# /local-holiday-success and the /api/customer/local-success* aliases). Leave unset on the live API.
# ALLOW_LOCAL_PAYMENTS=true

# ─── Existing env vars (keep below) ─────────────────────────────────────────────
# NODE_ENV=development
# PORT=5000
# DB_URL=mongodb+srv://...
# JWT_SECRET=...
# JWT_SECRET_FOR_VERIFY=...
# EMAIL_USER=...
# EMAIL_PASS=...
# HOST=smtp.yourprovider.com
# EMAIL_PORT=465
# ENCRYPT_PASSWORD=your-secret-passphrase   # Required: used to encrypt sensitive data at rest
# SCHOOL_REQUEST_ADMIN_EMAILS=admin@example.com  # Optional: comma-separated admin emails for school request notifications

# ─── Admin operations, notifications & background jobs ─────────────────────────
# Business settings edited from the dashboard (PUT /api/admin-ops/settings) are stored in
# MongoDB and override the values above at runtime; the .env values stay the defaults.

# Admin alert recipients (comma-separated). Also used by controller/Payment.js. Overridable in settings.
# ADMIN_NOTIFY_EMAILS=kavirajan@opendesignsin.com
# Days before a plan ends on which renewal reminders go out (comma-separated). Overridable in settings.
# RENEWAL_REMINDER_DAYS=7,3,1
# Last time of day (IST, HH:MM) to add/change tomorrow's meal — informational for now
# MEAL_CUTOFF_TIME=21:00
# "Try our meal" switch returned by /api/app-config (pro app)
# TRY_OUR_MEAL_ENABLED=false

# Firebase Cloud Messaging for admin push alerts (optional; needs `npm i firebase-admin`).
# Either the service-account JSON as one line, or a path to it. Unset = push disabled.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Background jobs (jobs/scheduler.js). Cron expressions run in Asia/Kolkata.
# Set RUN_CRON=false on serverless/multi-instance deploys and call POST /api/jobs/:name from an external cron instead.
# RUN_CRON=true
# Secret for POST /api/jobs/:name (header x-jobs-secret). Endpoint returns 503 when unset.
# JOBS_SECRET=change-me
# Renewal reminder emails + SMS (default 09:00 IST)
# RENEWAL_REMINDER_CRON=0 9 * * *
# Meal-adding reminder: off unless MEAL_REMINDER_ENABLED=true (default 18:00 IST)
# MEAL_REMINDER_ENABLED=false
# MEAL_REMINDER_CRON=0 18 * * *
# Expire ended plans / activate upcoming ones (default 00:15 IST)
# ROLL_SUBSCRIPTIONS_CRON=15 0 * * *
# Daily digest email of info/warning admin notifications (default 19:00 IST)
# ADMIN_DIGEST_CRON=0 19 * * *

# ─── Payment settlement & reconciliation ─────────────────────────────────────
# Website base URL used for post-payment redirects of website checkouts
# STORE_URL=https://lunchbowl.co.in
# CCAvenue Order Status API (needed to settle UPI payments whose browser callback never
# arrived). Must be enabled on the merchant account.
# CCAV_STATUS_API_ENABLED=true
# CCAV_STATUS_API_URL=https://api.ccavenue.com/apis/servlet/DoWebTrans
# CCAV_STATUS_ACCESS_CODE=            # only if different from CCAV_ACCESS_CODE
# RECONCILE_PAYMENTS_CRON=*/10 * * * *
# RECONCILE_MIN_AGE_MINUTES=5         # ask CCAvenue only for intents older than this
# RECONCILE_ALERT_AFTER_MINUTES=30    # alert admin about intents still unsettled after this
# RECONCILE_EXPIRE_HOURS=72           # intents with no result after this are marked expired
# Reject gateway callbacks that have no PaymentIntent (set to false once the website is on /initiate)
# CCAV_ACCEPT_LEGACY_CALLBACKS=true
