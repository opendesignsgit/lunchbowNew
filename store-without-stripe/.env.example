# LunchBowl customer website (store-without-stripe) — environment
# Copy to .env.local for development. NEXT_PUBLIC_* values are inlined at BUILD time.

# Base URL of the LunchBowl API, including the /api prefix. Every API call
# (src/services/httpServices.js) is made relative to this URL.
#   local:      http://localhost:5055/api
#   dev:        https://dev-api.lunchbowl.co.in/api
#   production: https://api.lunchbowl.co.in/api
NEXT_PUBLIC_API_BASE_URL=https://api.lunchbowl.co.in/api

# Public URL of this website (used by a few hard redirects, e.g. after a 401).
NEXT_PUBLIC_STORE_DOMAIN=https://lunchbowl.co.in

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Optional features
NEXT_PUBLIC_ENABLE_TRIAL=false
NEXT_PUBLIC_SMS_ENABLED=true
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# CCAvenue is handled entirely by the backend: the website calls
# POST /api/ccavenue/initiate and posts the encrypted request it gets back to the
# gateway. There is NO CCAvenue merchant id / access code / working key here and
# the website never decides the amount.
#
# The old NEXT_PUBLIC_DEV_RE1_PAYMENT (charge ₹1 on the test gateway) is gone from
# the website. It is now a BACKEND setting: CCAV_TEST_AMOUNT_RE1=true in the
# backend .env (dev/test only). The "Simulate Payment Success (Local)" buttons
# appear only on localhost / dev hosts and need ALLOW_LOCAL_PAYMENTS=true (or
# CCAV_MODE=test) on the backend.
